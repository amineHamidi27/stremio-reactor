{
  "manifest_version": 3,
  "name": "Stremio Reactor",
  "version": "0.2.0",
  "description": "Double sous-titres, mots cliquables et pause automatique pour apprendre les langues sur Stremio Web, YouTube et Netflix.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://opensubtitles-v3.strem.io/*",
    "https://*.strem.io/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.stremio.com/*",
        "https://app.strem.io/*",
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ],
      "js": ["lib/langs.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Stremio Reactor", "default_popup": "popup.html" }
}
